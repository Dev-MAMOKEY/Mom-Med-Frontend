# Expo 환경 변수 템플릿.
# 실제 .env는 .gitignore로 제외됩니다. cp .env.example .env 후 수정하세요.
#
# 모든 EXPO_PUBLIC_* 변수는 클라이언트 번들에 포함됩니다 — 비밀값은 절대 적지 마세요.

# 백엔드 API base URL.
# - 도커 백엔드: http://127.0.0.1:8080 (Windows에서 localhost가 IPv6로 해석되는 이슈 회피)
# - 호스트 native 백엔드: http://localhost:8080 OK
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8080

# true면 모든 API 호출이 mock으로 동작 (백엔드 없이 UI만 테스트).
# 데모 시연은 false로 두고 실제 백엔드 호출.
EXPO_PUBLIC_USE_MOCK=false

# true면 PhoneFrame(가짜 폰 테두리 + 시연 패널)을 web에서 표시. 시연용.
# production web 배포 시에는 false 권장.
EXPO_PUBLIC_SHOW_PHONE_FRAME=true

# true면 데모 모드 UI 분기(샘플 약·시연 안내 등) 활성화.
EXPO_PUBLIC_DEMO_MODE=true
